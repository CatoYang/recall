# Copy to .env (gitignored) and fill in. Never commit .env.

# Gemini - get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Anthropic - https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Which backend grades answers: anthropic | gemini
RECALL_BACKEND=gemini

# Optional: override the default model for the chosen backend
# RECALL_MODEL=gemini-flash-latest
